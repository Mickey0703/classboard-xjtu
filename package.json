{
  "name": "classboard-xjtu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "wrangler pages dev dist --port 8788 --ip 127.0.0.1",
    "preview:e2e": "wrangler pages dev dist --port 8788 --ip 127.0.0.1 --binding LOCAL_DEV_MODE=true --binding LOCAL_DEV_ADMIN_EMAIL=monitor@stu.xjtu.edu.cn --binding LOCAL_DEV_TOKEN=test-token --binding LOCAL_DEV_MEMBER_EMAIL=student@example.com --binding LOCAL_DEV_MEMBER_TOKEN=member-test --binding ADMIN_EMAILS=monitor@stu.xjtu.edu.cn",
    "db:init": "wrangler d1 execute DB --local --file=db/schema.sql",
    "db:demo": "wrangler d1 execute DB --local --file=db/demo.sql",
    "db:notifications": "wrangler d1 execute DB --local --file=db/migrations/002_notifications.sql",
    "db:notification-guards": "wrangler d1 execute DB --local --file=db/migrations/003_publish_recipients_trigger.sql",
    "db:notification-demo": "wrangler d1 execute DB --local --file=db/demo-notifications.sql",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cloudflare/pages-plugin-cloudflare-access": "^1.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
